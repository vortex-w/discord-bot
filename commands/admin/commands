    {
        name: 'loglist',
        description: 'Kilistázza a szerver logjait dátum és típus szerint.',
        permissionLevel: 'admin',

        slashOptions: [
            {
                name: 'start',
                description: 'Kezdő dátum ÉÉÉÉ-HH-NN formátumban',
                required: false
            },
            {
                name: 'end',
                description: 'Záró dátum ÉÉÉÉ-HH-NN formátumban',
                required: false
            },
            {
                name: 'type',
                description: 'Log típusa',
                required: false,
                choices: [
                    {
                        name: 'Hiba',
                        value: 'error'
                    },
                    {
                        name: 'Figyelmeztetés',
                        value: 'warn'
                    },
                    {
                        name: 'Információ',
                        value: 'info'
                    }
                ]
            }
        ],

        async getLogList(guildId, inputArgs = []) {
            const args = [...inputArgs];

            const allowedTypes = [
                'error',
                'warn',
                'info'
            ];

            const dateRegex = /^\d{4}-\d{2}-\d{2}$/;

            let type = null;
            let start = '0000-01-01 00:00:00';
            let end = '9999-12-31 23:59:59';
            let periodText = 'legutóbbi logok';

            /*
            * Ha az utolsó paraméter egy logtípus,
            * levesszük a dátumok közül.
            */
            if (
                args.length > 0 &&
                allowedTypes.includes(
                    args[args.length - 1].toLowerCase()
                )
            ) {
                type = args.pop().toLowerCase();
            }

            /*
            * Egyetlen dátum:
            * !loglist 2026-09-16
            */
            if (args.length === 1) {
                if (!dateRegex.test(args[0])) {
                    return {
                        error:
                            'Hibás dátumformátum.\n' +
                            'Helyes példa: !loglist 2026-09-16'
                    };
                }

                start = `${args[0]} 00:00:00`;
                end = `${args[0]} 23:59:59`;
                periodText = args[0];
            }

            /*
            * Két dátum:
            * !loglist 2026-09-15 2026-09-16
            */
            if (args.length === 2) {
                if (
                    !dateRegex.test(args[0]) ||
                    !dateRegex.test(args[1])
                ) {
                    return {
                        error:
                            'Hibás dátumformátum.\n' +
                            'Helyes példa: ' +
                            '!loglist 2026-09-15 2026-09-16'
                    };
                }

                if (args[0] > args[1]) {
                    return {
                        error:
                            'A kezdő dátum nem lehet későbbi, ' +
                            'mint a záró dátum.'
                    };
                }

                start = `${args[0]} 00:00:00`;
                end = `${args[1]} 23:59:59`;
                periodText = `${args[0]} – ${args[1]}`;
            }

            /*
            * Kettőnél több dátumparaméter nem megengedett.
            */
            if (args.length > 2) {
                return {
                    error:
                        'Hibás használat.\n\n' +
                        'Példák:\n' +
                        '!loglist\n' +
                        '!loglist 2026-09-16\n' +
                        '!loglist 2026-09-15 2026-09-16\n' +
                        '!loglist 2026-09-16 error\n' +
                        '!loglist 2026-09-15 2026-09-16 warn'
                };
            }

            const logs = await getLogsBetween(
                guildId,
                start,
                end,
                type,
                10,
                0
            );

            const total = await countLogsBetween(
                guildId,
                start,
                end,
                type
            );

            if (!logs || logs.length === 0) {
                return {
                    error:
                        'Nincs log a megadott időszakban' +
                        `${type ? ` (${type})` : ''}.`
                };
            }

            let text =
                `Logok – ${periodText}\n` +
                `${type ? `Típus: ${type}\n` : ''}` +
                `Megjelenítve: ${logs.length}/${total}\n\n`;

            for (const log of logs) {
                const userName =
                    log.user_name || 'nincs megadva';

                const userId =
                    log.user_id
                        ? ` (${log.user_id})`
                        : '';

                const message = String(log.message || '')
                    .replace(/```/g, "'''");

                text +=
                    `#${log.id} ` +
                    `[${log.created_at}] ` +
                    `${String(log.type).toUpperCase()}\n` +
                    `Felhasználó: ${userName}${userId}\n` +
                    `Üzenet: ${message}\n\n`;
            }

            /*
            * A Discord maximum 2000 karaktert enged.
            * A válaszokat 1900 karakteres részekre bontjuk.
            */
            const chunks = [];

            while (text.length > 1900) {
                let cutPosition = text.lastIndexOf(
                    '\n\n',
                    1900
                );

                if (cutPosition <= 0) {
                    cutPosition = 1900;
                }

                chunks.push(
                    text.slice(0, cutPosition)
                );

                text = text
                    .slice(cutPosition)
                    .trim();
            }

            if (text.length > 0) {
                chunks.push(text);
            }

            return {
                chunks
            };
        },

        async prefix(message, args) {
            const targetChannel =
                await getCommandTargetChannel(
                    message,
                    'loglist'
                );

            try {
                const result = await this.getLogList(
                    message.guild.id,
                    args
                );

                if (result.error) {
                    return targetChannel.send(
                        result.error
                    );
                }

                for (const chunk of result.chunks) {
                    await targetChannel.send(
                        '```\n' +
                        chunk +
                        '\n```'
                    );
                }

            } catch (error) {
                console.error(
                    'Hiba a loglist parancsnál:',
                    error
                );

                await logError(
                    error,
                    'Hiba a loglist parancsnál',
                    {
                        user_id: message.author.id,
                        user_name: message.author.username,
                        guild_id: message.guild.id,
                        guild_name: message.guild.name
                    }
                );

                await targetChannel.send(
                    'Hiba történt a logok lekérdezése közben.'
                );
            }
        },

        async slash(interaction) {
            try {
                const startDate =
                    interaction.options.getString('start');

                const endDate =
                    interaction.options.getString('end');

                const type =
                    interaction.options.getString('type');

                if (endDate && !startDate) {
                    return interaction.reply({
                        content:
                            'Záró dátum csak kezdő dátummal ' +
                            'együtt adható meg.',
                        ephemeral: true
                    });
                }

                const args = [];

                if (startDate) {
                    args.push(startDate);
                }

                if (endDate) {
                    args.push(endDate);
                }

                if (type) {
                    args.push(type);
                }

                const result = await this.getLogList(
                    interaction.guild.id,
                    args
                );

                if (result.error) {
                    return interaction.reply({
                        content: result.error,
                        ephemeral: true
                    });
                }

                await interaction.reply({
                    content:
                        '```\n' +
                        result.chunks[0] +
                        '\n```',
                    ephemeral: true
                });

                for (
                    const chunk of result.chunks.slice(1)
                ) {
                    await interaction.followUp({
                        content:
                            '```\n' +
                            chunk +
                            '\n```',
                        ephemeral: true
                    });
                }

            } catch (error) {
                console.error(
                    'Hiba a loglist slash parancsnál:',
                    error
                );

                await logError(
                    error,
                    'Hiba a loglist slash parancsnál',
                    {
                        user_id: interaction.user.id,
                        user_name: interaction.user.username,
                        guild_id: interaction.guild.id,
                        guild_name: interaction.guild.name
                    }
                );

                if (
                    !interaction.replied &&
                    !interaction.deferred
                ) {
                    await interaction.reply({
                        content:
                            'Hiba történt a logok ' +
                            'lekérdezése közben.',
                        ephemeral: true
                    });
                }
            }
        }
    },
    {
        name: 'deletelog',
        description : 'Kitörli az összes, a legutolsó, vagy egy adott napi logot. Használat: !deletelog all | last | 2026-03-21',
        permissionLevel : 'admin',

        async prefix(message, args){
            const targetChannel = await getCommandTargetChannel(message, 'deletelog');
            const mode = (args[0] || "").trim();

            if(!mode){
                return targetChannel.send(
                    'Használat:\n' +
                    '!deletelog all\n' +
                    '!deletelog last\n' +
                    '!deletelog 2026-03-21'
                );
            }

            const dateRegex = /^\d{4}-\d{2}-\d{2}$/;

            try{
                if(mode === "all"){
                    const result = await deleteAllLogs();

                    await targetChannel.send(
                        `Az összes log törölve lett. Törölt elemek száma: **${result?.changes || 0}**`
                    );

                    await logInfo(
                        `Admin log törlés | mód: all | törlő: ${message.author.username} (${message.author.id})`,
                        "info"
                    );

                    return;
                }

                if(mode === "last"){
                    const lastLog = await getLastLog();

                    if(!lastLog){
                        return targetChannel.send("Nincs törölhető log bejegyzés.");
                    }

                    const result = await deleteLastLog();

                    if(!result || result.changes === 0){
                        return targetChannel.send("A legutolsó log törlése nem sikerült.");
                    }

                    await targetChannel.send(
                        `A legutolsó log törölve lett.\n` +
                        `ID: **${lastLog.id}**\n` +
                        `Típus: **${lastLog.type}**\n` +
                        `Dátum: **${lastLog.created_at}**`
                    );

                    await logInfo(
                        `Admin log törlés | mód: last | törölt log id: ${lastLog.id} | törlő: ${message.author.username} (${message.author.id})`,
                        "info"
                    );

                    return;
                }

                if(dateRegex.test(mode)){
                    const logs = await getLogsByDate(mode);

                    if(!logs || logs.length === 0){
                        return targetChannel.send(`Nincs log ezen a napon: **${mode}**`);
                    }

                    const result = await deleteLogsByDate(mode);

                    await targetChannel.send(
                        `A(z) **${mode}** napi logok törölve lettek. Törölt elemek száma: **${result?.changes || 0}**`
                    );

                    await logInfo(
                        `Admin log törlés | mód: dátum | dátum: ${mode} | törölt elemek: ${result?.changes || 0} | törlő: ${message.author.username} (${message.author.id})`,
                        "info"
                    );

                    return;
                }

                return targetChannel.send(
                    'Hibás paraméter.\n' +
                    'Használat:\n' +
                    '!deletelog all\n' +
                    '!deletelog last\n' +
                    '!deletelog 2026-03-21'
                );

            }catch(error){
                console.error("Hiba a deletelog parancsnál:", error);
                await logError(error, "Hiba a deletelog parancsnál");
                return targetChannel.send("Hiba történt a log törlése közben.");
            }
        }
